{
  "name": "tufan-blox-bridge",
  "version": "0.7.1",
  "description": "MCP server for Roblox Studio AI-driven development — scripts, instances, properties, Luau execution, two-way file sync, and git history.",
  "type": "module",
  "bin": {
    "tufan-blox-bridge": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "roblox",
    "mcp",
    "studio",
    "ai",
    "luau",
    "model-context-protocol",
    "tufan"
  ],
  "author": "Tufan Studio",
  "license": "MIT",
  "homepage": "https://github.com/drgost1/Tufan-Blox-Bridge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drgost1/Tufan-Blox-Bridge.git",
    "directory": "server"
  },
  "bugs": {
    "url": "https://github.com/drgost1/Tufan-Blox-Bridge/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chokidar": "^4.0.3",
    "express": "^4.21.2",
    "simple-git": "^3.27.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}