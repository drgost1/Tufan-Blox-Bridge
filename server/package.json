{
  "name": "tufan-blox-bridge",
  "version": "0.16.2",
  "mcpName": "io.github.drgost1/tufan-blox-bridge",
  "description": "Roblox Studio MCP server and plugin: an add-on to Roblox's built-in Studio MCP with snapshots, two-way script sync, git, backdoor scanning, Luau linting and bulk builds for Claude Code, Cursor and any MCP client.",
  "type": "module",
  "bin": {
    "tufan-blox-bridge": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "TufanBloxBridge.rbxm"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepack": "node --input-type=commonjs -e \"require('fs').copyFileSync('../TufanBloxBridge.rbxm','TufanBloxBridge.rbxm')\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "roblox",
    "roblox-studio",
    "roblox-mcp",
    "roblox-studio-mcp",
    "roblox-plugin",
    "roblox-studio-plugin",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "luau",
    "claude",
    "claude-code",
    "cursor",
    "ai",
    "ai-agent",
    "game-development",
    "backdoor-scanner",
    "tufan"
  ],
  "author": "Tufan Studio",
  "license": "MIT",
  "homepage": "https://www.tufanstudio.net/roblox-studio-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drgost1/Tufan-Blox-Bridge.git",
    "directory": "server"
  },
  "bugs": {
    "url": "https://github.com/drgost1/Tufan-Blox-Bridge/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chokidar": "^4.0.3",
    "express": "^4.21.2",
    "simple-git": "^3.27.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
